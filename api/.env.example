# Local development. Keep real values in api/.env or the cPanel environment UI.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Production: use your own HTTPS origin and a unique administrator password.
# Password must be at least 16 characters in production. No defaults are supplied.
PUBLIC_ORIGIN=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Empty means same-origin browser requests only. Optional explicit origins, comma separated.
# Example: https://www.example.com
CORS_ALLOWED_ORIGINS=

# Set angular for the combined Angular release; legacy preserves the original UI.
APP_FRONTEND=legacy
# Paths are relative to api (or absolute). Defaults use angular/dist/*/browser.
ANGULAR_PUBLIC_DIR=
ANGULAR_ADMIN_DIR=
